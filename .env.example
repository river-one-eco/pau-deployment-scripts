# Chain RPC URL (used by foundry.toml `mainnet` endpoint and the Makefile deploy targets)
MAINNET_RPC_URL=
# RPC URL picked up by forge/cast when no --rpc-url is passed (usually same as above)
ETH_RPC_URL=

# Deploy targets only (see Makefile prerequisites):
# ETH_FROM=            # deployer address (keystore account "deployer")

# Post-deploy verification only (make test-postdeploy-mainnet[-simulate]), all optional:
# POSTDEPLOY_SIMULATE=true # run DeployPAU.s.sol on the fork inside the test and verify its result
# POSTDEPLOY_OUTPUT=script/output/1/deploy-pau-latest.json   # real output JSON to verify (project-relative)
# POSTDEPLOY_BLOCK=        # fork block; pin to a block right after the deployment for reproducibility
# POSTDEPLOY_FROM_BLOCK=   # first block scanned by eth_getLogs (narrow for RPCs that cap the range)
